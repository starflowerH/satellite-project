# Environment variable example.
# Copy this file to .env.development and adjust values for your machine.

# Backend API server.
VITE_API_BASE_URL=http://localhost:3000

# Vite development server port.
VITE_PORT=5173

# Enable Vite proxy.
VITE_PROXY_ENABLED=true

# WebSocket server, if needed.
# VITE_WS_URL=ws://localhost:3000

# Auth config.
# VITE_AUTH_TOKEN_KEY=access_token
# VITE_REFRESH_TOKEN_KEY=refresh_token

# Third-party service config.
# VITE_GOOGLE_CLIENT_ID=your_google_client_id
# VITE_GITHUB_CLIENT_ID=your_github_client_id
# VITE_AMAP_KEY=your_amap_jsapi_key
# VITE_AMAP_ROUTE_KEY=your_amap_webservice_key
