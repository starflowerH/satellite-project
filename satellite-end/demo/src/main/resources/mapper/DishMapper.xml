<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.DishMapper">

    <resultMap id="DishResultMap" type="com.example.demo.pojo.Dish">
        <id column="id" property="id"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="name" property="name"/>
        <result column="price" property="price"/>
        <result column="is_signature" property="isSignature"/>
        <result column="spicy_level" property="spicyLevel"/>
        <result column="flavor_notes" property="flavorNotes"/>
        <result column="allergens_or_ingredients" property="allergensOrIngredients"/>
    </resultMap>

    <select id="findById" resultMap="DishResultMap">
        SELECT * FROM t_dish WHERE id = #{id}
    </select>

    <select id="listByMerchantId" resultMap="DishResultMap">
        SELECT * FROM t_dish
        WHERE merchant_id = #{merchantId}
        ORDER BY is_signature DESC, price ASC, id ASC
    </select>

    <select id="listByMerchantIds" resultMap="DishResultMap">
        SELECT * FROM t_dish
        WHERE merchant_id IN
        <foreach collection="merchantIds" item="mId" open="(" separator="," close=")">
            #{mId}
        </foreach>
        ORDER BY is_signature DESC, price ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_dish (
            merchant_id, name, price, is_signature,
            spicy_level, flavor_notes, allergens_or_ingredients
        ) VALUES (
            #{merchantId}, #{name}, #{price}, #{isSignature},
            #{spicyLevel}, #{flavorNotes}, #{allergensOrIngredients}
        )
    </insert>

    <update id="update">
        UPDATE t_dish
        <set>
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="price != null">price = #{price},</if>
            <if test="isSignature != null">is_signature = #{isSignature},</if>
            <if test="spicyLevel != null">spicy_level = #{spicyLevel},</if>
            <if test="flavorNotes != null">flavor_notes = #{flavorNotes},</if>
            <if test="allergensOrIngredients != null">allergens_or_ingredients = #{allergensOrIngredients},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_dish WHERE id = #{id}
    </delete>

    <delete id="deleteByMerchantId">
        DELETE FROM t_dish WHERE merchant_id = #{merchantId}
    </delete>

</mapper>
