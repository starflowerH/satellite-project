server:
  port: 8080

spring:
  data:
    redis:
      host: localhost
      port: 6379
      database: 0
  datasource:
    # 1. 驱动保持不变
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 2. 修改 URL：将 localhost 换成你的数据库域名
    # 注意：txrw 是你的数据库名，请确保你已经创建了这个库
    url: ${DB_URL:jdbc:mysql://localhost:3306/txrw?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai}
    # 3. 账号
    username: ${DB_USERNAME:root}
    # 4. 修改密码：从环境变量中读取，禁止明文硬编码生产密码
    password: ${DB_PASSWORD:******}

  mail:
    host: ${MAIL_HOST:smtp.qq.com}
    port: ${MAIL_PORT:465}
    username: ${MAIL_USERNAME:example@qq.com}
    password: ${MAIL_PASSWORD:******}
    protocol: smtp
    default-encoding: UTF-8
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: ${MAIL_SMTP_STARTTLS:false}
          ssl:
            enable: ${MAIL_SMTP_SSL:true}
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000

app:
  mail:
    from: ${MAIL_FROM:${MAIL_USERNAME:example@qq.com}}
    from-name: ${MAIL_FROM_NAME:TX任务网}

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.example.demo.pojo
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl